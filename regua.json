      "first_name",
      "order_id",
      "net_amount",
      "paid_at",
      "bank_account"
    ]
  },
  {
    "id": "15-pedido-cancelado",
    "group": "Antecipação",
    "screen": "OT5",
    "trigger": "Pedido cancelado, recusado ou expirado",
